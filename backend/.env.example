# ============================================
# AetherTracker — Environment Variables Guide
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit your .env file to git.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/aethertracker"

# --- Session ---
# Any long random string (32+ characters)
SESSION_SECRET="your-super-secret-session-key"

# --- App URL ---
# IMPORTANT: This must match your Google Cloud Redirect URI.
# LOCAL: http://localhost:3000
# RENDER: https://your-app-name.onrender.com (Get this from Render dashboard)
# If not set, it will default to http://localhost:3000 locally.
APP_URL="http://localhost:3000"

# --- Google OAuth2 ---
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Brevo Email API ---
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""

# --- Gemini AI (Optional) ---
GEMINI_API_KEY=""
